---
import {renderMermaidSvg} from '../lib/mermaid';

interface Props {
  id: string;
  label: string;
  source: string;
}

const { id, label, source } = Astro.props;
const svg = await renderMermaidSvg(source, `${id}-svg`);
---

<figure id={id} class="mermaid-diagram" role="img" aria-label={label}>
  <Fragment set:html={svg} />
</figure>
