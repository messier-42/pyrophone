---
import { createNodeEngine } from '@mermanjs/node';

interface Props {
  id: string;
  label: string;
  source: string;
}

const { id, label, source } = Astro.props;
const engine = await createNodeEngine();
let svg: string;

try {
  svg = await engine.renderSvg(source.trim(), {
    optionsJson: JSON.stringify({
      version: 3,
      site_config: {
        theme: 'base',
        htmlLabels: false,
        themeVariables: {
          fontFamily: 'system-ui, sans-serif',
          primaryColor: '#f2f0e5',
          primaryTextColor: '#100f0f',
          primaryBorderColor: '#878580',
          lineColor: '#575653',
          edgeLabelBackground: '#fffcf0',
        },
      },
      svg: {
        diagram_id: `${id}-svg`,
        root_background_color: '#fffcf0',
      },
    }),
  });
} finally {
  await engine.dispose();
}
---

<figure id={id} class="mermaid-diagram" role="img" aria-label={label}>
  <Fragment set:html={svg} />
</figure>

<style>
  .mermaid-diagram {
    margin-inline: 0;
  }

  .mermaid-diagram :global(svg) {
    display: block;
    height: auto;
    margin-inline: auto;
  }
</style>
